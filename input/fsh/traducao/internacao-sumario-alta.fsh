RuleSet: TraducaoPtBrInternacaoSumarioAlta
* . ^short = "Internação do Sumário de Alta"
* . ^definition = "Internação a que o Sumário de Alta se refere. Concentra o que no SA-IG estava em seções próprias: período, caráter, procedência, desfecho da alta, diagnósticos com papel (admissão, alta), profissional da alta e o resumo da evolução clínica (Encounter.text)."
* period.id ^short = "Identificador do elemento"
* period.id ^definition = "Identificador único do elemento dentro do recurso, para referências internas."
* period.extension ^short = "Extensões adicionais"
* period.extension ^definition = "Extensões que acrescentam informação não prevista no modelo base."
* period.start ^short = "Data e hora da admissão"
* period.start ^definition = "Início da internação."
* period.end ^short = "Data e hora da alta"
* period.end ^definition = "Fim da internação."
