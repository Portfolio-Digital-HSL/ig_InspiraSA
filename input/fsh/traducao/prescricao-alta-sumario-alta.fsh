// GERADO por scripts/traducao_ptbr.py. Não edite à mão.
RuleSet: TraducaoPtBrPrescricaoAltaSumarioAlta
* . ^short = "Prescrição de Alta"
* . ^definition = "Medicamento prescrito para uso após a alta. Cada item é um MedicationRequest ligado diretamente à seção prescricaoAlta, sem a Composition intermediária BRRegistroPrescricaoMedicamento do SA-IG. Turno e intervalo entre doses usam Dosage.timing (substituem BRTurno e BRIntervaloDoses)."
* doNotPerform ^short = "Não realizar"
* doNotPerform ^definition = "Indica que a ação NÃO deve ser realizada."
* dosageInstruction.timing.id ^short = "Identificador do elemento"
* dosageInstruction.timing.id ^definition = "Identificador único do elemento dentro do recurso, para referências internas."
* dosageInstruction.timing.extension ^short = "Extensões adicionais"
* dosageInstruction.timing.extension ^definition = "Extensões que acrescentam informação não prevista no modelo base."
* dosageInstruction.timing.modifierExtension ^short = "Extensões que não podem ser ignoradas"
* dosageInstruction.timing.modifierExtension ^definition = "Extensões que alteram o significado do elemento e não podem ser ignoradas por quem não as reconhece."
* dosageInstruction.timing.event ^short = "Momentos exatos"
* dosageInstruction.timing.event ^definition = "Datas e horas em que a dose deve ser administrada."
* dosageInstruction.timing.repeat.id ^short = "Identificador do elemento"
* dosageInstruction.timing.repeat.id ^definition = "Identificador único do elemento dentro do recurso, para referências internas."
* dosageInstruction.timing.repeat.extension ^short = "Extensões adicionais"
* dosageInstruction.timing.repeat.extension ^definition = "Extensões que acrescentam informação não prevista no modelo base."
* dosageInstruction.timing.repeat.bounds[x] ^short = "Limites do esquema"
* dosageInstruction.timing.repeat.bounds[x] ^definition = "Duração total ou período em que o esquema se aplica."
* dosageInstruction.timing.repeat.count ^short = "Número de repetições"
* dosageInstruction.timing.repeat.count ^definition = "Quantas vezes a dose deve ser repetida."
* dosageInstruction.timing.repeat.countMax ^short = "Máximo de repetições"
* dosageInstruction.timing.repeat.countMax ^definition = "Limite superior do número de repetições."
* dosageInstruction.timing.repeat.duration ^short = "Duração de cada administração"
* dosageInstruction.timing.repeat.duration ^definition = "Tempo de cada administração (ex.: infusão de 30 min)."
* dosageInstruction.timing.repeat.durationMax ^short = "Duração máxima"
* dosageInstruction.timing.repeat.durationMax ^definition = "Limite superior da duração de cada administração."
* dosageInstruction.timing.repeat.durationUnit ^short = "Unidade da duração"
* dosageInstruction.timing.repeat.durationUnit ^definition = "Unidade de tempo da duração (s, min, h, d, wk, mo, a)."
* dosageInstruction.timing.repeat.frequency ^definition = "Quantas vezes por período (ex.: 3 vezes ao dia)."
* dosageInstruction.timing.repeat.frequencyMax ^short = "Frequência máxima"
* dosageInstruction.timing.repeat.frequencyMax ^definition = "Limite superior da frequência."
* dosageInstruction.timing.repeat.period ^definition = "Intervalo a que a frequência se refere (substitui o BRIntervaloDoses do SA-IG)."
* dosageInstruction.timing.repeat.periodMax ^short = "Período máximo"
* dosageInstruction.timing.repeat.periodMax ^definition = "Limite superior do período."
* dosageInstruction.timing.repeat.periodUnit ^short = "Unidade do período"
* dosageInstruction.timing.repeat.periodUnit ^definition = "Unidade de tempo do período (s, min, h, d, wk, mo, a)."
* dosageInstruction.timing.repeat.dayOfWeek ^definition = "Dias da semana em que a dose é administrada."
* dosageInstruction.timing.repeat.timeOfDay ^short = "Horário do dia"
* dosageInstruction.timing.repeat.timeOfDay ^definition = "Horário fixo da administração."
* dosageInstruction.timing.repeat.when ^short = "Turno ou evento"
* dosageInstruction.timing.repeat.when ^definition = "Momento do dia ou evento (manhã, noite, antes das refeições). Substitui o BRTurno do SA-IG."
* dosageInstruction.timing.repeat.offset ^short = "Minutos do evento"
* dosageInstruction.timing.repeat.offset ^definition = "Minutos antes ou depois do evento indicado em when."
* dosageInstruction.timing.code ^definition = "Código que identifica o conceito."
* dispenseRequest.validityPeriod.extension ^short = "Extensões adicionais"
* dispenseRequest.validityPeriod.extension ^definition = "Extensões que acrescentam informação não prevista no modelo base."
* dispenseRequest.validityPeriod.end ^definition = "Data e hora de término do período."
