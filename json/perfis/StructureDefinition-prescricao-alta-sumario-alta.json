{
  "resourceType": "StructureDefinition",
  "id": "prescricao-alta-sumario-alta",
  "url": "http://fhir.hsl.org.br/ig/inspirasa/StructureDefinition/prescricao-alta-sumario-alta",
  "name": "PrescricaoAltaSumarioAlta",
  "title": "Prescrição de Alta",
  "status": "draft",
  "experimental": true,
  "description": "Medicamento prescrito para uso após a alta. Cada item é um MedicationRequest ligado diretamente à seção prescricaoAlta, sem a Composition intermediária BRRegistroPrescricaoMedicamento do SA-IG. Turno e intervalo entre doses usam Dosage.timing (substituem BRTurno e BRIntervaloDoses).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "MedicationRequest",
  "baseDefinition": "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-medicationrequest",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "MedicationRequest",
        "path": "MedicationRequest",
        "short": "Prescrição de Alta",
        "definition": "Medicamento prescrito para uso após a alta. Cada item é um MedicationRequest ligado diretamente à seção prescricaoAlta, sem a Composition intermediária BRRegistroPrescricaoMedicamento do SA-IG. Turno e intervalo entre doses usam Dosage.timing (substituem BRTurno e BRIntervaloDoses).",
        "constraint": [
          {
            "key": "pa-1",
            "severity": "error",
            "human": "O medicamento DEVE ser informado por referência a br-core-medication (medicationReference).",
            "expression": "medication.ofType(Reference).exists()",
            "source": "http://fhir.hsl.org.br/ig/inspirasa/StructureDefinition/prescricao-alta-sumario-alta"
          }
        ]
      },
      {
        "id": "MedicationRequest.identifier",
        "path": "MedicationRequest.identifier",
        "mustSupport": true
      },
