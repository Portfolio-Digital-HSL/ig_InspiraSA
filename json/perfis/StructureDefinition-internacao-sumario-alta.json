{
  "resourceType": "StructureDefinition",
  "id": "internacao-sumario-alta",
  "url": "http://fhir.hsl.org.br/ig/inspirasa/StructureDefinition/internacao-sumario-alta",
  "name": "InternacaoSumarioAlta",
  "title": "Internação do Sumário de Alta",
  "status": "draft",
  "experimental": true,
  "description": "Internação a que o Sumário de Alta se refere. Concentra o que no SA-IG estava em seções próprias: período, caráter, procedência, desfecho da alta, diagnósticos com papel (admissão, alta), profissional da alta e o resumo da evolução clínica (Encounter.text).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Encounter",
  "baseDefinition": "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-encounter",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Encounter",
        "path": "Encounter",
        "short": "Internação do Sumário de Alta",
        "definition": "Internação a que o Sumário de Alta se refere. Concentra o que no SA-IG estava em seções próprias: período, caráter, procedência, desfecho da alta, diagnósticos com papel (admissão, alta), profissional da alta e o resumo da evolução clínica (Encounter.text).",
        "constraint": [
          {
            "key": "isa-1",
            "severity": "error",
            "human": "A internação do Sumário de Alta DEVE ter data de alta (period.end).",
            "expression": "period.end.exists()",
            "source": "http://fhir.hsl.org.br/ig/inspirasa/StructureDefinition/internacao-sumario-alta"
          }
        ]
      },
      {
        "id": "Encounter.text",
        "path": "Encounter.text",
        "short": "Resumo da evolução clínica",
        "comment": "Substitui o perfil ClinicalImpression (resumoEvolucaoClinica) do SA-IG. Texto livre, narrativa XHTML.",
        "mustSupport": true
      },
      {
        "id": "Encounter.identifier",
        "path": "Encounter.identifier",
        "mustSupport": true
      },
      {
        "id": "Encounter.status",
        "path": "Encounter.status",
        "patternCode": "finished",
        "mustSupport": true
      },
      {
        "id": "Encounter.class",
        "path": "Encounter.class",
        "patternCoding": {
          "code": "IMP",
          "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode"
        },
        "mustSupport": true
      },
      {
        "id": "Encounter.priority",
        "path": "Encounter.priority",
        "mustSupport": true
      },
      {
        "id": "Encounter.subject",
        "path": "Encounter.subject",
        "mustSupport": true
      },
      {
        "id": "Encounter.participant",
        "path": "Encounter.participant",
        "mustSupport": true
      },
      {
        "id": "Encounter.participant.type",
        "path": "Encounter.participant.type",
        "comment": "Use BRResponsabilidadeParticipante: alta, admissao, atendimento. Substitui o BRIdentificacaoEquipe do SA-IG.",
        "mustSupport": true
      },
      {
        "id": "Encounter.participant.individual",
        "path": "Encounter.participant.individual",
        "mustSupport": true
      },
      {
        "id": "Encounter.period",
        "path": "Encounter.period",
        "mustSupport": true
      },
      {
        "id": "Encounter.period.id",
        "path": "Encounter.period.id",
        "short": "Identificador do elemento",
        "definition": "Identificador único do elemento dentro do recurso, para referências internas."
      },
      {
        "id": "Encounter.period.extension",
        "path": "Encounter.period.extension",
        "short": "Extensões adicionais",
        "definition": "Extensões que acrescentam informação não prevista no modelo base."
      },
      {
        "id": "Encounter.period.start",
        "path": "Encounter.period.start",
        "short": "Data e hora da admissão",
        "definition": "Início da internação.",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Encounter.period.end",
        "path": "Encounter.period.end",
        "short": "Data e hora da alta",
        "definition": "Fim da internação.",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Encounter.reasonCode",
        "path": "Encounter.reasonCode",
        "mustSupport": true
      },
      {
        "id": "Encounter.diagnosis",
        "path": "Encounter.diagnosis",
        "mustSupport": true
      },
      {
        "id": "Encounter.diagnosis.condition",
        "path": "Encounter.diagnosis.condition",
        "mustSupport": true
      },
      {
        "id": "Encounter.diagnosis.use",
